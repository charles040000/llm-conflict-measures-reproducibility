# Google BigQuery / GDELT
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service_account_key.json
GDELT_DATA_ROOT=data/raw
GDELT_START_DATE=20200101
GDELT_END_DATE=20251231
GDELT_SAMPLE_MODE=true
GDELT_SAMPLE_LIMIT=1000

# OpenAI labeling
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano

# Optional pipeline tuning
GDELT_SCRAPE_WORKERS=8
GDELT_CLEAN_WORKERS=8
GDELT_PROCESS_START_METHOD=fork
